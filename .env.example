# Server Configuration
PORT=3000
NODE_ENV=development

# Database Configuration (Default SQLite for local zero-config, or PostgreSQL for production)
DATABASE_URL="file:./dev.db?connection_limit=1&timeout=20000"
# Example PostgreSQL URL:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/wallet_db?schema=public"

# JWT Authentication
JWT_SECRET=super_secret_jwt_key_wallet_production_2026_change_in_prod
JWT_EXPIRES_IN=24h

# Redis Idempotency (Optional: gracefully falls back to in-memory store if unreachable)
REDIS_URL=redis://localhost:6379
REDIS_ENABLED=false

# Logging & Monitoring
LOG_LEVEL=info
